# =============================================================================
# AppArmor Profile for NurOS Containers (STRICT MODE)
# =============================================================================
# Security-hardened profile following the principle of least privilege.
# Designed for NurOS package search containers.
#
# Installation:
#   sudo cp container-apparmor-profile-strict /etc/apparmor.d/
#   sudo apparmor_parser -r /etc/apparmor.d/container-apparmor-profile-strict
#   sudo aa-enforce container-nuros-strict
#
# Usage:
#   docker run --security-opt apparmor=container-nuros-strict ...
#   podman run --security-opt apparmor=container-nuros-strict ...
# =============================================================================

#include <tunables/global>

profile container-nuros-strict flags=(attach_disconnected,mediate_deleted) {
  # Include minimal base abstractions
  #include <abstractions/base>
  #include <abstractions/nameservice>
  
  # ============================================================================
  # NETWORK - Restricted to TCP/UDP only (no ICMP/ping)
  # ============================================================================
  network inet tcp,
  network inet udp,
  # No ICMP - prevents network scanning from container
  # No raw sockets
  
  # DNS resolution (required)
  network inet dgram,
  
  # ============================================================================
  # CAPABILITIES - Minimal set (removed dangerous ones)
  # ============================================================================
  # Basic capabilities needed for container operation
  capability chown,
  capability fowner,
  capability fsetid,
  capability kill,
  capability setgid,
  capability setuid,
  capability net_bind_service,
  capability audit_write,
  
  # REMOVED for security:
  # - dac_override (allows ignoring file permissions) - CRITICAL
  # - dac_read_search (allows reading any file) - CRITICAL
  # - mknod (create device nodes) - not needed
  # - sys_chroot (change root directory) - not needed, dangerous
  # - setpcap (modify capabilities) - not needed, dangerous
  # - setfcap (set file capabilities) - not needed, privilege escalation risk
  # - sys_module (loading kernel modules) - CRITICAL
  # - sys_rawio (raw I/O access) - CRITICAL
  # - sys_pacct (process accounting)
  # - sys_nice (priority manipulation)
  # - sys_resource (resource limits)
  # - sys_time (system clock)
  # - sys_tty_config (TTY configuration)
  # - reboot (system reboot)
  # - sys_boot (changing domain name)
  # - ipc_lock, ipc_owner, lease, linux_immutable
  # - mac_admin, mac_override
  # - net_admin, net_broadcast, net_raw
  # - wake_alarm, block_suspend
  
  # ============================================================================
  # FILE SYSTEM - Explicit paths only (no blanket 'file' rule)
  # ============================================================================
  
  # Read-only access to system directories
  /etc/hosts r,
  /etc/resolv.conf r,
  /etc/hostname r,
  /etc/passwd r,
  /etc/group r,
  /etc/nsswitch.conf r,
  
  # Read-only access to SSL/TLS certificates
  /etc/ssl/** r,
  /etc/pki/** r,
  /etc/ca-certificates/** r,
  
  # Read-only access to timezone
  /etc/timezone r,
  /etc/localtime r,
  
  # Read-only access to shared libraries
  /lib/** r,
  /lib64/** r,
  /usr/lib/** r,
  
  # Read-only access to binaries
  /bin/** r,
  /usr/bin/** r,
  /sbin/** r,
  /usr/sbin/** r,
  
  # Application directory (read-write for build/test)
  /app/** rw,
  /workspace/** rw,
  /src/** rw,
  
  # Temporary directories (no execute!)
  /tmp/ r,
  /tmp/** rw,
  /var/tmp/ r,
  /var/tmp/** rw,
  
  # Node.js/npm cache (read-write, but on tmpfs in compose)
  /root/.npm/** rw,
  /root/.cache/** rw,
  
  # Git configuration (if needed)
  /root/.gitconfig rw,
  /etc/gitconfig r,
  
  # ============================================================================
  # DENY RULES - Explicit denials for sensitive paths
  # ============================================================================
  
  # Deny access to firmware and kernel
  deny /sys/firmware/** rw,
  deny /sys/kernel/** rw,
  deny /sys/fs/cgroup/** rw,
  deny /sys/module/** rw,
  
  # Deny access to proc sensitive files
  deny /proc/kcore rw,
  deny /proc/sysrq-trigger rw,
  deny /proc/acpi/** rw,
  deny /proc/asound/** rw,
  deny /proc/bus/** rw,
  deny /proc/fs/** rw,
  deny /proc/irq/** rw,
  deny /proc/scsi/** rw,
  deny /proc/sys/** w,
  
  # Deny access to hardware devices
  deny /dev/mem rw,
  deny /dev/kmem rw,
  deny /dev/port rw,
  deny /dev/sd* rw,
  deny /dev/hd* rw,
  deny /dev/nvme* rw,
  
  # Deny access to user home directories on host
  deny /home/*/** rw,
  deny /root/** rw,
  
  # Deny access to Docker/Podman internals
  deny /var/run/docker.sock rw,
  deny /var/run/podman/** rw,
  deny /run/docker.sock rw,
  deny /run/podman/** rw,
  
  # Deny access to container runtime files
  deny /run/.containerenv rw,
  deny /etc/mtab w,
  deny /etc/fstab w,
  
  # ============================================================================
  # MOUNT - Restricted (no arbitrary mounts)
  # ============================================================================

  # Allow only specific mount types needed for container operation
  mount options=(ro) /proc -> /proc,
  mount options=(ro) /sys -> /sys,
  mount fstype=tmpfs tmpfs,
  mount fstype=devpts devpts,

  # Deny all other mounts
  deny mount,
  
  # ============================================================================
  # SIGNAL - Restricted (no signaling host processes)
  # ============================================================================
  
  # Allow signals only within the container
  signal (send) peer=container-nuros-strict,
  signal (receive) peer=container-nuros-strict,
  
  # Deny signaling processes outside the container
  deny signal (send) peer=unconfined,
  
  # ============================================================================
  # PTRACE - Disabled (no debugging)
  # ============================================================================
  
  # Deny ptrace completely for security
  deny ptrace,
  
  # ============================================================================
  # UNIX SOCKETS - Restricted
  # ============================================================================
  
  # Allow unix stream sockets for local IPC
  unix stream,
  
  # ============================================================================
  # EXECUTION - Restricted to known binaries
  # ============================================================================
  
  # Allow execution of standard binaries
  /bin/** ix,
  /usr/bin/** ix,
  /sbin/** ix,
  /usr/sbin/** ix,
  
  # Allow execution in application directory
  /app/** ix,
  /workspace/** ix,
  /src/** ix,
  
  # Explicitly DENY execution from /tmp (security!)
  deny /tmp/** ix,
  deny /var/tmp/** ix,
  
  # ============================================================================
  # AUDIT - Log denied accesses
  # ============================================================================
  
  # Audit denied accesses for monitoring
  audit deny @{PROC}/sys/kernel/** w,
  audit deny /sys/kernel/** w,
}
